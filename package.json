{
  "name": "gta-v-projects",
  "version": "1.0.0",
  "private": true,
  "description": "Five independent GTA V simulation and engineering applications organized in separate project folders",
  "scripts": {
    "dev:highway": "pnpm --filter neon-highway-drive dev",
    "dev:phone": "pnpm --filter in-browser-phone-os dev",
    "dev:chat": "pnpm --filter real-time-crew-chat dev",
    "dev:briefings": "pnpm --filter ai-mission-briefings dev",
    "dev:newspaper": "pnpm --filter scroll-driven-newspaper dev",
    "build:highway": "pnpm --filter neon-highway-drive build",
    "build:phone": "pnpm --filter in-browser-phone-os build",
    "build:chat": "pnpm --filter real-time-crew-chat build",
    "build:briefings": "pnpm --filter ai-mission-briefings build",
    "build:newspaper": "pnpm --filter scroll-driven-newspaper build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
