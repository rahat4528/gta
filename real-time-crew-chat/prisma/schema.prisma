datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum ChannelType {
  TEXT
  VOICE
  DM
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  displayName   String?
  passwordHash  String
  avatarUrl     String?
  statusMessage String?
  isOnline      Boolean   @default(false)
  lastSeenAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  crewMembers   CrewMember[]
  ownedCrews    Crew[]           @relation("CrewOwner")
  messages      Message[]
  reactions     MessageReaction[]
  readReceipts  ReadReceipt[]
}

model Crew {
  id          String       @id @default(uuid())
  name        String
  description String?
  iconUrl     String?
  inviteCode  String       @unique @default(cuid())
  ownerId     String
  owner       User         @relation("CrewOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members     CrewMember[]
  channels    Channel[]
}

model CrewMember {
  id        String   @id @default(uuid())
  userId    String
  crewId    String
  role      Role     @default(MEMBER)
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  crew      Crew     @relation(fields: [crewId], references: [id], onDelete: Cascade)

  @@unique([userId, crewId])
  @@index([crewId])
}

model Channel {
  id          String      @id @default(uuid())
  crewId      String
  name        String
  topic       String?
  type        ChannelType @default(TEXT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  crew        Crew        @relation(fields: [crewId], references: [id], onDelete: Cascade)
  messages    Message[]
  readReceipts ReadReceipt[]

  @@index([crewId])
}

model Message {
  id           String            @id @default(uuid())
  channelId    String
  senderId     String
  content      String
  clientTempId String?           @unique // Idempotent deduplication key
  isEdited     Boolean           @default(false)
  isDeleted    Boolean           @default(false)
  replyToId    String?
  replyTo      Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReplies")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  channel      Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions    MessageReaction[]
  attachments  Attachment[]

  @@index([channelId, createdAt])
  @@index([clientTempId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Attachment {
  id        String   @id @default(uuid())
  messageId String
  fileUrl   String
  fileName  String
  fileSize  Int
  fileType  String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ReadReceipt {
  id                String   @id @default(uuid())
  channelId         String
  userId            String
  lastReadMessageId String?
  lastReadAt        DateTime @default(now())

  channel           Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
}
