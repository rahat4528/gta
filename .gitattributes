# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp3 binary
*.wav binary

# Shell scripts and batch files
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
